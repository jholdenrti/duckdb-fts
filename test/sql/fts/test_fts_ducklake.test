# name: test/sql/fts/test_fts_ducklake.test
# description: FTS indexes on DuckLake tables (no trigger support), at DuckLake spec 1.0 and 1.1, and across the 1.0 -> 1.1 migration
# group: [fts]

require fts

require ducklake

require parquet

require skip_reload

require no_alternative_verify

# a catalog on spec 1.0 (stores match_bm25's NULL defaults as 1.1 does) and on spec 1.1
foreach VER 1.0 1.1

statement ok
ATTACH 'ducklake:duckdb:{TEST_DIR}/fts_dl_{VER}.db' AS dl (DATA_PATH '{TEST_DIR}/fts_dl_{VER}_files', DUCKLAKE_VERSION '{VER}')

query I
SELECT value = '{VER}' FROM __ducklake_metadata_dl.ducklake_metadata WHERE key = 'version'
----
true

statement ok
USE dl

statement ok
CREATE OR REPLACE TABLE docs (id INTEGER NOT NULL, title VARCHAR, body VARCHAR)

statement ok
INSERT INTO docs VALUES
    (1, 'ducks', 'the duck swims on the lake'),
    (2, 'geese', 'a goose and a duck and another duck'),
    (3, 'swans', 'swans glide on still water'),
    (4, 'duck lake', 'nothing to see here')

# previously: Not implemented Error: Triggers are not supported for this table type
statement ok
PRAGMA create_fts_index('docs', 'id', 'title', 'body')

statement ok
PRAGMA create_fts_index('docs', 'id', 'title', 'body', overwrite=1)

statement error
PRAGMA create_fts_index('docs', 'id', 'title', 'body')
----
a FTS index already exists

# incremental indexes need triggers: rejected up front
statement error
PRAGMA create_fts_index('docs', 'id', 'title', 'body', overwrite=1, incremental=1)
----
incremental FTS indexes require trigger support

query I
SELECT count(*) FROM duckdb_triggers() WHERE database_name = 'dl'
----
0

# no table is touched by the index build
query I
SELECT count(*) FROM docs
----
4

statement ok
USE memory

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:duckdb:{TEST_DIR}/fts_dl_{VER}.db' AS dl (DATA_PATH '{TEST_DIR}/fts_dl_{VER}_files', DUCKLAKE_VERSION '{VER}')

statement ok
USE dl

# macro parameter defaults after re-attach: the text 'NULL' (never SQL NULL), read back as NULL
query IIII
SELECT p.parameter_name, p.default_value IS NULL, p.default_value, p.default_value_type
FROM __ducklake_metadata_dl.ducklake_macro_parameters p
JOIN __ducklake_metadata_dl.ducklake_macro m USING (macro_id)
WHERE m.macro_name = 'match_bm25' AND m.end_snapshot IS NULL
ORDER BY p.column_id
----
docname	false	NULL	unknown
query_string	false	NULL	unknown
fields	false	NULL	null
k	false	1.2	decimal(2,1)
b	false	0.75	decimal(3,2)
conjunctive	false	false	boolean
field_weights	false	NULL	null
field_b	false	NULL	null
scoring_model	false	bm25f	varchar
tie_breaker	false	0.0	decimal(2,1)

# fields := NULL (default) searches every indexed field, ranked
query II
SELECT id, round(score, 6) FROM (
    SELECT id, fts_main_docs.match_bm25(id, 'duck') AS score FROM docs
) WHERE score IS NOT NULL ORDER BY score DESC, id
----
1	0.212044
2	0.194734
4	0.124374

# same scores as the same index on a native DuckDB table
statement ok
CREATE OR REPLACE TABLE memory.main.docs AS FROM dl.docs

statement ok
USE memory

statement ok
PRAGMA create_fts_index('docs', 'id', 'title', 'body', overwrite=1)

statement ok
CREATE OR REPLACE TEMP TABLE native_scores AS
SELECT id, fts_main_docs.match_bm25(id, 'duck') AS score FROM docs

statement ok
USE dl

query I
SELECT count(*) FROM docs d JOIN native_scores n USING (id)
WHERE fts_main_docs.match_bm25(d.id, 'duck') IS DISTINCT FROM n.score
----
0

# defaults are identical to spelling them out
query I
SELECT count(*) FROM docs
WHERE fts_main_docs.match_bm25(id, 'duck') IS NOT DISTINCT FROM
      fts_main_docs.match_bm25(id, 'duck', fields := NULL, k := 1.2, b := 0.75, conjunctive := false)
----
4

# fields restricts the search
query I
SELECT id FROM (
    SELECT id, fts_main_docs.match_bm25(id, 'duck', fields := 'title') AS score FROM docs
) WHERE score IS NOT NULL ORDER BY score DESC, id
----
1
4

query I
SELECT id FROM (
    SELECT id, fts_main_docs.match_bm25(id, 'duck lake', conjunctive := true) AS score FROM docs
) WHERE score IS NOT NULL ORDER BY score DESC, id
----
1
4

# rebuild after re-attach and after data changes
statement ok
INSERT INTO docs VALUES (5, 'drake', 'a male duck')

statement ok
PRAGMA create_fts_index('docs', 'id', 'title', 'body', overwrite=1)

query I
SELECT id FROM (
    SELECT id, fts_main_docs.match_bm25(id, 'drake') AS score FROM docs
) WHERE score IS NOT NULL
----
5

statement ok
PRAGMA drop_fts_index('docs')

statement error
SELECT fts_main_docs.match_bm25(1, 'duck')
----
fts_main_docs

# the exact PRAGMAs the interface API issues (store/rag_index.go, store/schema_index.go),
# run with dl as the current catalog
statement ok
CREATE SCHEMA rag

statement ok
CREATE TABLE rag.sabc123 (chunk_id INTEGER NOT NULL, doc_id VARCHAR NOT NULL, doc_name VARCHAR NOT NULL,
    chunk_index INTEGER NOT NULL, text VARCHAR NOT NULL, vector FLOAT[] NOT NULL, section_path VARCHAR)

statement ok
INSERT INTO rag.sabc123 VALUES
    (1, 'd1', 'a.pdf', 0, 'quarterly revenue grew in the north region', [0.1], NULL),
    (2, 'd1', 'a.pdf', 1, 'headcount was flat', [0.2], NULL),
    (3, 'd2', 'b.pdf', 0, 'revenue revenue forecast', [0.3], 'Intro')

statement ok
CREATE TABLE rag.schema_index (chunk_key VARCHAR NOT NULL, table_name VARCHAR NOT NULL, column_name VARCHAR NOT NULL,
    content VARCHAR NOT NULL, content_hash VARCHAR NOT NULL, embedding FLOAT[] NOT NULL, indexed_at TIMESTAMP NOT NULL)

statement ok
INSERT INTO rag.schema_index VALUES
    ('sales', 'sales', '', 'table sales: revenue by region', 'h1', [0.1], TIMESTAMP '2026-01-01'),
    ('sales.region', 'sales', 'region', 'column region of sales', 'h2', [0.2], TIMESTAMP '2026-01-01')

foreach RUN 1 2

statement ok
PRAGMA create_fts_index('rag.sabc123', 'chunk_id', 'text', overwrite = 1)

statement ok
PRAGMA create_fts_index('rag.schema_index', 'chunk_key', 'content', overwrite = 1)

endloop

statement ok
USE memory

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:duckdb:{TEST_DIR}/fts_dl_{VER}.db' AS dl (DATA_PATH '{TEST_DIR}/fts_dl_{VER}_files', DUCKLAKE_VERSION '{VER}')

statement ok
USE dl

query I
SELECT chunk_id FROM (
    SELECT chunk_id, fts_rag_sabc123.match_bm25(chunk_id, 'revenue') AS score FROM dl.rag.sabc123
) WHERE score IS NOT NULL ORDER BY score DESC
----
3
1

query I
SELECT chunk_key FROM (
    SELECT chunk_key, fts_rag_schema_index.match_bm25(chunk_key, 'region') AS score FROM dl.rag.schema_index
) WHERE score IS NOT NULL ORDER BY score DESC, chunk_key
----
sales.region
sales

statement ok
USE memory

statement ok
DETACH dl

endloop

# the 1.0 catalog migrated to 1.1: indexes built on 1.0 keep working and rebuild
statement ok
ATTACH 'ducklake:duckdb:{TEST_DIR}/fts_dl_1.0.db' AS dl (DATA_PATH '{TEST_DIR}/fts_dl_1.0_files', DUCKLAKE_VERSION '1.1', AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM __ducklake_metadata_dl.ducklake_metadata WHERE key = 'version'
----
1.1

query I
SELECT count(*) FROM __ducklake_metadata_dl.ducklake_macro_parameters WHERE default_value IS NULL
----
0

statement ok
USE dl

query I
SELECT chunk_id FROM (
    SELECT chunk_id, fts_rag_sabc123.match_bm25(chunk_id, 'revenue') AS score FROM dl.rag.sabc123
) WHERE score IS NOT NULL ORDER BY score DESC
----
3
1

statement ok
PRAGMA create_fts_index('rag.schema_index', 'chunk_key', 'content', overwrite = 1)

query I
SELECT chunk_key FROM (
    SELECT chunk_key, fts_rag_schema_index.match_bm25(chunk_key, 'region') AS score FROM dl.rag.schema_index
) WHERE score IS NOT NULL ORDER BY score DESC, chunk_key
----
sales.region
sales

statement ok
USE memory

statement ok
DETACH dl

# native DuckDB tables keep trigger-maintained incremental indexes
statement ok
CREATE TABLE native_docs (id INTEGER NOT NULL, body VARCHAR)

statement ok
INSERT INTO native_docs VALUES (1, 'the duck swims')

statement ok
PRAGMA create_fts_index('native_docs', 'id', 'body', incremental=1)

query I
SELECT count(*) > 0 FROM duckdb_triggers() WHERE trigger_name LIKE '__fts_%'
----
true

statement ok
INSERT INTO native_docs VALUES (2, 'another duck')

query I
SELECT id FROM native_docs WHERE fts_main_native_docs.match_bm25(id, 'duck') IS NOT NULL ORDER BY id
----
1
2

statement ok
PRAGMA create_fts_index('native_docs', 'id', 'body', incremental=1, overwrite=1)

query I
SELECT count(*) > 0 FROM duckdb_triggers() WHERE trigger_name LIKE '__fts_%'
----
true
